# Segundos que un asiento queda reservado antes de liberarse.
HOLD_TTL_SECONDS=120

# URL usada al generar el QR de las boletas.
PUBLIC_BASE_URL=http://localhost:8080

# Paneles de la rúbrica.
GRAFANA_PASSWORD=tiquart
WG_HOST=demo.tiquart.local
WG_PASSWORD=tiquart
