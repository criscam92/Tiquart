# Copia este archivo a .env antes de levantar la demo:
#   cp .env.example .env
# Los valores son de demo; no usar en producción.

POSTGRES_PASSWORD=tiquart
JWT_SECRET=tiquart-demo-jwt-secret-change-me-2026
TICKET_SECRET=tiquart-demo-ticket-secret-2026
